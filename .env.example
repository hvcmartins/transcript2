# ─── rdtlTranscript — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values

# Required: Groq API key (get one free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Server settings
PORT=6133
HOST=0.0.0.0

# Persistent storage paths (local dev; in Docker these are set via -e flags)
UPLOAD_DIR=./uploads
DATA_DIR=./data
